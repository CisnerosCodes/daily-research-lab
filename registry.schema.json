{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daily-research-lab experiment registry row",
  "type": "object",
  "required": ["id", "date", "title", "slug", "hypothesis", "status"],
  "properties": {
    "id": { "type": "string", "description": "unique dedup key, e.g. 2026-07-21_gol-depth-recursion" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string" },
    "slug": { "type": "string" },
    "hypothesis": { "type": "string" },
    "question": { "type": "string" },
    "method": { "type": "string" },
    "architecture": { "type": "string" },
    "dataset": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "license": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    "task": { "type": "string" },
    "framework": { "type": "string" },
    "seed": { "type": "integer" },
    "compute": { "type": "string" },
    "metrics": { "type": "object" },
    "result_summary": { "type": "string" },
    "status": { "type": "string", "enum": ["idea", "in_progress", "done", "failed", "abandoned", "spun_out"] },
    "novelty_check": {
      "type": "object",
      "properties": {
        "checked_on": { "type": "string" },
        "verdict": { "type": "string", "enum": ["novel", "partial-prior-art", "replication", "unchecked"] },
        "sources": { "type": "array", "items": { "type": "object" } },
        "conclusion": { "type": "string" }
      }
    },
    "prior_art": { "type": "array", "items": { "type": "string" } },
    "related_ids": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
